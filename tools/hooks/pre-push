#!/usr/bin/env bash
# tools/hooks/pre-push — the repo's only automatic test gate.
#
# WHY THIS EXISTS
#
# There is no per-push CI. `appveyor.yml` has `branches.only` set to version
# tags, so it is a *release packaging* pipeline: it never sees an ordinary
# commit, and until 2026-08-17 it had no test_script at all. GitHub Actions was
# abandoned after the account was rate-throttled (CHANGELOG "GitHub Actions is
# no longer used"). The net effect was that nothing ran the test suite
# automatically, ever.
#
# That is not theoretical. A 2026-08-17 audit found, all accumulated silently:
#   * a data race in core/scheduler's Stop()
#   * two Go modules (cmd/daal-core, cmd/daal-soak-engine) that could not build
#   * `go vet` failing in four modules
#   * tools/check-hardcoded-strings.sh printing OK while never running
#
# Every one would have been caught by running the suite once.
#
# INSTALL
#
#   git config core.hooksPath tools/hooks
#
# (Repo-relative, so it is version-controlled and every clone can opt in with
# one command. .git/hooks/ cannot be tracked.)
#
# BYPASS
#
#   git push --no-verify        # or: DAAL_SKIP_PREPUSH=1 git push
#
# Bypass deliberately, not habitually. If this is slow enough that you want to
# skip it routinely, fix the slowness — a gate that is always bypassed is the
# false-green this hook exists to replace.

set -uo pipefail

if [[ "${DAAL_SKIP_PREPUSH:-0}" == "1" ]]; then
  echo "pre-push: skipped via DAAL_SKIP_PREPUSH=1"
  exit 0
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT" || exit 1

fail=0
step() {
  local name="$1"; shift
  printf '\n\033[1m▶ %s\033[0m\n' "$name"
  if "$@"; then
    printf '\033[32m  ✓ %s\033[0m\n' "$name"
  else
    printf '\033[31m  ✗ %s\033[0m\n' "$name"
    fail=1
  fi
}

echo "pre-push: running the suite (bypass: git push --no-verify)"

# The build contract: CI and developers both go through ./daal, so the two
# cannot drift. See the header of ./daal.
step "daal test"        ./daal test

# go vet across every module. `./daal test` does not vet, and vet was red in
# four modules for an unknown length of time.
vet_all() {
  local rc=0 m
  for m in $(find . -name go.mod -not -path "*/node_modules/*" | sed 's|/go.mod||'); do
    # cmd/daal-soak-engine only compiles under its build tag.
    if [[ "$m" == "./cmd/daal-soak-engine" ]]; then
      (cd "$m" && go vet -tags soak ./... ) || rc=1
    else
      (cd "$m" && go vet ./... ) || rc=1
    fi
  done
  return $rc
}
step "go vet (all modules)" vet_all

step "cargo test (daal-wizard)" bash -c 'cd client-shell/tauri/daal-wizard && cargo test --quiet'
step "tsc + vite build"         bash -c 'cd client-ui && npm run build --silent'

# The TS unit suite. `./daal test` builds client-ui but never runs
# vitest, so until Wave 4 Step 11 the ~80 tests under client-ui/src —
# including the QR frame-format and session-contract regressions that
# exist precisely because those seams broke silently — ran only when a
# human remembered to. A test nothing runs is a comment.
step "vitest (client-ui)"       bash -c 'cd client-ui && npm test --silent'

# Static gates. Each exits non-zero on a real finding; check-hardcoded-strings
# now also exits non-zero when its own dependency (ripgrep) is missing, rather
# than printing OK and scanning nothing.
for g in tools/check-hardcoded-strings.sh tools/check-diagnostics-redaction.sh tools/check-tokens.sh tools/check-phase.sh tools/check-deploy-so-manifest.sh tools/check-engine-so-manifest.sh; do
  [[ -x "$g" ]] && step "$(basename "$g")" "./$g"
done
[[ -f tools/check-plumbing.mjs ]] && step "check-plumbing.mjs" node tools/check-plumbing.mjs

# One transport family lives in three tables in two languages with no
# import edge between them (the pack vocabulary, the dial-capability
# table, and the badge the user reads). The TS mirror drifted twice in
# Wave 5 alone, and a family missing from it renders as "unhandled"
# rather than failing, so nothing else notices.
[[ -f tools/check-family-maturity.mjs ]] && step "check-family-maturity.mjs" node tools/check-family-maturity.mjs

# The box→publisher credential struct is declared three times in two
# languages with no import edge. Three separate fields have now been
# silently dropped on that hop (mux_inbound in Wave 2, anytls_password in
# Wave 5), each costing a whole wave, each invisible because serde and
# encoding/json both ignore unknown keys. Nothing else can see this seam.
[[ -f tools/check-creds-mirror.mjs ]] && step "check-creds-mirror.mjs" node tools/check-creds-mirror.mjs

# The L4/L6 confirm sheets decide whether their own button is pressable
# from TS mirrors of four Go tables (the toolbox profiles, the region →
# peering-neighbourhood map, the per-provider region lists, and the
# recommender's wall-clock column). They have to be mirrors, not copies:
# the profile table is what tells the operator a profile change would
# remove nothing before they delete a server for it, and the region
# table is what stops the sheet offering a datacentre the provider does
# not have — reprovision deletes the box before provision finds out.
[[ -f tools/check-toolbox-profiles.mjs ]] && step "check-toolbox-profiles.mjs" node tools/check-toolbox-profiles.mjs

# Every rung of the rotation ladder is reachable from a screen, and the
# rungs that DELETE the relay refuse before they delete it. Neither
# property is visible to check-plumbing.mjs: the rung is a string
# argument, so a gate that checks commands sees one green
# `wizard_rotate_execute` whether it drives one rung or six — which is
# how L4, L5 and L6 sat fully coded and callable by nothing.
[[ -f tools/check-rotation-ladder.mjs ]] && step "check-rotation-ladder.mjs" node tools/check-rotation-ladder.mjs

# The QR sender has no camera in CI, so this gate tests everything up to
# the glass: the vendored QR encoder against an independent one
# (skip2/go-qrcode), the rendered symbols against a real scanner (jsQR),
# and the frame sequencing against the real Go fountain codec — feeding
# what the screen would display, with frames dropped, back into the real
# decoder. It needs go + client-ui/node_modules and exits 2 rather than
# passing quietly if either is missing.
[[ -f tools/check-qr-send.mjs ]] && step "check-qr-send.mjs" node tools/check-qr-send.mjs

if (( fail )); then
  printf '\n\033[31mpre-push: FAILED — push aborted.\033[0m\n'
  printf 'Fix the above, or bypass deliberately with: git push --no-verify\n'
  exit 1
fi

printf '\n\033[32mpre-push: all checks passed.\033[0m\n'
exit 0
