#cloud-config
# Daal relay cloud-init V2 — supplement §9.5.2 (verbatim shape).
# Extends V1.5 template with daal-relay-mgmt installation and the
# V2 cloud-provider firewall + persistent narrow-API mgmt service
# posture. Rendered by publisher/deploy/cloudinit/template.go::RenderV2.
# The OS hostname names nothing. Nothing on this box serves it to a
# stranger today (ssh is off after provisioning, no MTA, no web
# server), but the next thing that does - a banner, an error page -
# should not say what this box is for. "ubuntu" is the image's own
# default. Cloud-init has no upgrade path: fresh relays only.
hostname: ubuntu
manage_etc_hosts: true
package_update: true
package_upgrade: false

bootcmd:
  - |
    mkdir -p /root/.ssh
    cat >/root/.ssh/authorized_keys <<'EOF'
    {{ .EphemeralSSHPublicKey }}
    EOF
    chmod 700 /root/.ssh
    chmod 600 /root/.ssh/authorized_keys

packages:
  - curl
  - ca-certificates
  - openssl
  - python3
  - ufw

users:
  - name: daal
    sudo: false
    shell: /usr/sbin/nologin
    lock_passwd: true

ssh_authorized_keys:
  - {{ .EphemeralSSHPublicKey }}

write_files:
  - path: /etc/daal/artifacts.json
    permissions: '0644'
    content: |
{{ .PinnedArtifactManifest | indent 6 }}

  - path: /etc/daal/release.pub
    permissions: '0644'
    content: |
{{ .DaalReleasePubKey | indent 6 }}

  - path: /usr/local/bin/daal-fetch-verify
    permissions: '0755'
    content: |
{{ .VerifierShim | indent 6 }}

  - path: /etc/sing-box/config.json
    permissions: '0600'
    owner: root:root
    content: |
{{ .SingBoxConfigJSON | indent 6 }}

  # The one way this box applies a rewritten sing-box config. Every
  # mgmt verb that changes the user table calls it ONCE.
  #
  # `reload` is ExecReload= in sing-box.service below: SIGHUP, which
  # sing-box 1.13 handles in-process (cmd/sing-box/cmd_run.go) — it
  # re-checks the config on disk, keeps the running instance if that
  # check fails, and otherwise closes every inbound and every live
  # connection and starts the new instance. That close is what makes a
  # revoke real for a session that is already up.
  #
  # `restart` is the fallback for a unit with no ExecReload (a box whose
  # unit file predates it); it costs the same sessions.
  #
  # This used to send SIGUSR2 and sleep 2 s first. sing-box registers no
  # handler for SIGUSR2 and Go ignores it, so that was two seconds of
  # nothing in front of every credential change.
  - path: /usr/local/lib/daal/singbox-kick.sh
    permissions: '0755'
    owner: root:root
    content: |
      #!/bin/sh
      set -eu
      systemctl reload sing-box.service || systemctl restart sing-box.service

  # FRP-10 V2 mgmt-plane: per-deploy publisher pubkey + listening
  # port + sing-box config path are written by cloud-init from the
  # wizard's RenderInputV2. The cert/key are generated on the box
  # at first boot by daal-relay-mgmt itself.
  - path: /etc/daal/mgmt/pubkey
    permissions: '0644'
    owner: root:root
    content: |
      {{ .MgmtPubKeyHex }}

  - path: /etc/daal/mgmt/port
    permissions: '0644'
    owner: root:root
    content: |
      {{ .MgmtPort }}
{{ if .CoverSNI }}
  # Wave 2: the REALITY cover host THIS relay advertises, chosen
  # per-relay by the publisher (publisher/deploy/sni) rather than baked
  # in as a fleet-wide constant. The same string is already inside
  # /etc/sing-box/config.json in two places — tls.server_name and
  # reality.handshake.server, which must never disagree — so this file
  # is not the source of truth for sing-box. It is the box's own
  # statement of what it serves, so /rotate-tls and a human on the box
  # can both read the current value without parsing sing-box's config.
  - path: /etc/daal/cover-sni
    permissions: '0644'
    owner: root:root
    content: |
      {{ .CoverSNI }}
{{ end }}
{{ if .Families }}
  # The family set THIS relay serves, one name per line, resolved once by
  # the publisher at provision time. The sing-box inbounds above and the
  # ufw rules below were derived from the same list. daal-relay-mgmt
  # reads it on every user-table change and creates inbounds — and
  # credentials — for these families only: without it the daemon cannot
  # know which of the on-first-use inbounds (naive-in, ws-in, ss-in,
  # anytls-in) this relay was asked for, and creates them all.
  - path: /etc/daal/families
    permissions: '0644'
    owner: root:root
    content: |
{{- range .Families }}
      {{ . }}
{{- end }}
{{ end }}
{{ if .CDNEnabled }}
  - path: /etc/daal/cdn/origin_ca.pem
    permissions: '0644'
    owner: root:root
    content: |
{{ .OriginCACertPEM | indent 6 }}

  - path: /etc/daal/cdn/origin_ca.key
    permissions: '0600'
    owner: root:root
    content: |
{{ .OriginCAPrivPEM | indent 6 }}

  - path: /etc/daal/cdn/aop_client.pem
    permissions: '0600'
    owner: root:root
    content: |
{{ .AOPClientCertPEM | indent 6 }}
{{ end }}

  - path: /etc/daal-health/config.json
    permissions: '0600'
    content: |
      {
        "one_time_token": "{{ .HealthToken }}",
        "allowed_client_ip": "{{ .ProvisioningClientIP }}",
        "auto_close_after_seconds": 300,
        "publish_mgmt_fingerprint_path": "/var/log/daal/mgmt-tls.fpr"
      }

  - path: /etc/systemd/system/sing-box.service
    permissions: '0644'
    content: |
      [Unit]
      Description=sing-box (Daal relay)
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=simple
      ExecStart=/usr/local/bin/sing-box run -c /etc/sing-box/config.json
      ExecReload=/bin/kill -HUP $MAINPID
      Restart=on-failure
      RestartSec=5
      LimitNOFILE=1048576
      AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
      CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
      NoNewPrivileges=true
      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/daal-health.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Daal relay health endpoint (provisioning-window only, §9.6)
      After=sing-box.service
      Wants=sing-box.service
      [Service]
      Type=simple
      ExecStart=/usr/local/bin/daal-relay-health -config /etc/daal-health/config.json
      Restart=no
      User=daal
      Group=daal
      NoNewPrivileges=true
      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/daal-relay-mgmt.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Daal relay V2 management plane (§9.5.2)
      After=sing-box.service network-online.target
      Wants=sing-box.service network-online.target
      [Service]
      Type=simple
      ExecStart=/usr/local/bin/daal-relay-mgmt
      Restart=on-failure
      RestartSec=5
      User=root
      Group=root
      NoNewPrivileges=true
      # CAP_NET_ADMIN is L3's guest-OS half (Wave 3c, supplement §4.8).
      # A floating IP is ROUTED to this server by the provider, but the
      # kernel drops packets for an address no interface holds, so
      # /bind-address configures it — and /unbind-address removes it
      # again before the address goes back to the provider's pool.
      #
      # The ADD direction could be delegated to the daal-bound-addresses
      # oneshot (PID 1 grants it the capability). The REMOVE direction
      # cannot: that unit only adds, because at boot the interface holds
      # the primary address, which is not a record, and a reconcile that
      # removed non-records would delete it. Without this line the
      # service advertises one capability token for two verbs and can
      # only perform one, so a failed swap cannot roll back and
      # `floating-ip release` can never complete.
      #
      # It is not a widening of what this unit can already reach: it
      # runs as root, writes /etc/systemd/system and asks PID 1 to start
      # a unit it authored with AmbientCapabilities=CAP_NET_ADMIN, so
      # the bounding set was never a boundary for it. sing-box.service
      # on this same box already holds the same capability. Holding it
      # directly makes the two verbs symmetric and the refusal honest.
      AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
      CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
      [Install]
      WantedBy=multi-user.target

runcmd:
  # FRP-10: box-side ufw is closed for mgmt; cloud-provider firewall
  # is the gate (§9.5.2). We open the served families' data-plane ports
  # for sing-box and the helper-bound 22 + 9876 health windows for the
  # provisioning step only.
  - |
    bash -euo pipefail <<'DAAL_PROVISION'
    fail() {
      mkdir -p /var/log/daal
      printf '%s\n' "$1" | tee /var/log/daal-provision.fail
      exit 1
    }
    run() {
      "$@" || fail "$* failed"
    }
    run ufw default deny incoming
    run ufw default allow outgoing
    # Data-plane ports: one per family THIS relay serves and nothing
    # else. Not a constant list, and no unconditional 443 rule: it is
    # relayports.FirewallPortsFor(<this relay's families>) via
    # RenderInput.DataPlanePorts, so a family this relay was not asked to
    # serve — a default one included — leaves no open port here. This
    # runs ONCE, at first boot — there is no upgrade path for cloud-init,
    # so changing a relay's family set means reprovisioning it, not
    # editing a rule.
{{- range .UFWDataPlaneRules }}
    run ufw allow {{ . }}
{{- end }}
{{- if .CDNUFWRules }}
    # Add-on 2 (way in through Cloudflare): the CDN door, ws-cdn-in, is
    # reachable from Cloudflare's published ranges only. Present only
    # when the provisioner fetched them (a CLI opt-in); otherwise
    # daal-relay-mgmt /cdn writes the same rules when the door is
    # turned on. Nothing listens here until then, and the relay
    # firewall at the provider opens the port only then.
{{- range .CDNUFWRules }}
    run ufw allow {{ . }}
{{- end }}
{{- end }}
    run ufw allow from {{ .ProvisioningClientIP }} to any port 22 proto tcp
    run ufw allow from {{ .ProvisioningClientIP }} to any port 9876 proto tcp
    # FRP-14 fix: open the V2 mgmt port at the box-side firewall too.
    # FRP-10 invariant 18 says the cloud-provider firewall is the
    # gate for the mgmt port — that's true for SOURCE filtering, but
    # the packet still has to traverse the box-side ufw. If we keep
    # ufw default-deny and add no rule, every mgmt request is
    # dropped at the box even after the cloud firewall lets it
    # through (this caused the /users/provision context-deadline
    # timeout). Opening the port at the box is safe because the
    # cloud-provider firewall still restricts the SOURCE to the
    # ephemeral helper-IP window.
    run ufw allow {{ .MgmtPort }}/tcp
    run ufw --force enable
    chown daal:daal /etc/daal-health/config.json || fail "chown /etc/daal-health/config.json failed"
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config || fail "enable provisioning ssh failed"
    systemctl restart ssh.service 2>/dev/null || systemctl restart sshd.service || fail "restart ssh failed"
    /usr/local/bin/daal-fetch-verify /etc/daal/artifacts.json /etc/daal/release.pub /usr/local/bin/ || fail "artifact verification failed"
    # FRP-14: the canonical sing-box config ships with an empty
    # REALITY private_key; sing-box refuses to start without one.
    # Mint a real X25519 keypair on first boot, then surgically
    # inject the priv into every REALITY inbound's TLS block. The
    # PUBLIC key is written next to it so future rotate-credentials
    # calls (and per-recipient .sbpx bundling) can read it without
    # re-running keygen.
    #
    # A relay that does not serve vless-reality has no REALITY inbound
    # (the publisher renders the config from the relay's family set).
    # That is exit status 3 below and it is not an error: nothing is
    # keyed and /etc/daal/reality.pub is NOT written, so the box never
    # states a REALITY key it does not serve.
    keys="$(/usr/local/bin/sing-box generate reality-keypair)" || fail "reality-keypair gen failed"
    reality_priv="$(printf '%s\n' "$keys" | awk '/PrivateKey:/ {print $2}')"
    reality_pub="$(printf '%s\n' "$keys" | awk '/PublicKey:/ {print $2}')"
    [ -n "$reality_priv" ] || fail "reality-keypair: empty PrivateKey"
    mkdir -p /etc/daal
    reality_rc=0
    REALITY_PRIV="$reality_priv" python3 -c "$(printf '%s\n' \
      'import json, os, sys' \
      'path = "/etc/sing-box/config.json"' \
      'cfg = json.load(open(path))' \
      'priv = os.environ["REALITY_PRIV"]' \
      'patched = False' \
      'for inb in cfg.get("inbounds") or []:' \
      '    tls = inb.get("tls")' \
      '    if not isinstance(tls, dict):' \
      '        continue' \
      '    reality = tls.get("reality")' \
      '    if isinstance(reality, dict) and reality.get("enabled"):' \
      '        reality["private_key"] = priv' \
      '        patched = True' \
      'if not patched:' \
      '    sys.exit(3)' \
      'json.dump(cfg, open(path, "w"))')" || reality_rc=$?
    case "$reality_rc" in
      0)
        printf '%s\n' "$reality_pub" > /etc/daal/reality.pub
        chmod 0644 /etc/daal/reality.pub
        ;;
      3) ;;
      *) fail "inject reality priv failed" ;;
    esac
    # FRP-14: data-plane self-signed TLS cert for the hy2/naive/ws
    # inbounds (TLS families that, unlike REALITY, need a cert). ws/hy2
    # pin it by SPKI SHA-256 (no name check). naive/Cronet, however,
    # enforces SAN matching with no CN fallback, so the leaf carries an
    # iPAddress SAN for the box's own public IP(s); the naive client sets
    # server_name to that IP. Generated here so it exists before sing-box
    # first starts, and persists for the box's life.
    #
    # Validity MUST stay short: the naive client rides Cronet (Chromium's
    # net stack), which installs this leaf as a trusted ROOT and therefore
    # runs the CA/Browser-Forum max-validity check on it. Chromium
    # (cert_verify_proc.cc HasTooLongValidity, CABF BR 2.1.7) caps validity
    # by the cert's issue date and rejects anything longer with
    # ERR_CERT_VALIDITY_TOO_LONG (net_error -213):
    #   issued >= 2026-03-15: 200 days
    #   issued >= 2027-03-15: 100 days
    #   issued >= 2029-03-15:  47 days
    # ws/hy2 pin by SPKI and ignore validity, so a too-long cert breaks
    # ONLY naive — silently. 90 days sits under the 100-day bracket too,
    # so a box provisioned any time before 2029-03-15 is safe; relays
    # rotate well within 90 days. Shorten to <=47 before 2029-03-15.
    DAAL_IP4="$(ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1 | head -1)"
    DAAL_IP6="$(ip -6 -o addr show eth0 scope global | awk '{print $4}' | cut -d/ -f1 | head -1)"
    DAAL_SAN="IP:${DAAL_IP4}"
    [ -n "$DAAL_IP6" ] && DAAL_SAN="${DAAL_SAN},IP:${DAAL_IP6}"
    DAAL_CN="${DAAL_IP4}"
{{- if .CoverSNI }}
    # ONE STABLE DNS NAME, so naive survives an address move (L3).
    # This certificate is minted once and cannot follow the box to a
    # floating address: after assign-fip the pack dials an address no
    # iPAddress SAN names and Cronet refuses the handshake
    # (ERR_CERT_COMMON_NAME_INVALID), on the only address that is not
    # blocked. A DNS name does not depend on the address. The naive
    # client verifies against it ONLY when the address it dials is not
    # in this certificate (bundle.NaiveVerificationName), so a relay
    # that never moves puts nothing new on the wire. The name is the
    # cover host this relay was provisioned with — the one hostname
    # already chosen to be plausible for this address. It follows the
    # cover host: when rotate-tls moves it, daal-relay-mgmt re-issues
    # this certificate on the SAME key (no pin moves) with the new cover
    # host as the first DNS name and this one kept after it.
    DAAL_SAN="${DAAL_SAN},DNS:{{ .CoverSNI }}"
    DAAL_CN="{{ .CoverSNI }}"
{{- end }}
    # THE SUBJECT NAMES NOTHING THE CERTIFICATE DOES NOT ALREADY SAY.
    # This certificate is served to anybody who completes a handshake
    # on 8444, 8445 or 443/udp, credentials or not. Its subject used to
    # be the app's name, identical on every relay, readable by any
    # prober (review C1). The subject is now the certificate's own first
    # name — the cover host, or the address when there is none — which
    # is what the ordinary self-signed recipe (`openssl req -x509 -subj
    # /CN=<host>`, Debian's snakeoil cert) produces, differs per relay,
    # and repeats a SAN, so it adds nothing a prober could not already
    # read. Nothing verifies it: six families pin the key, and naive
    # (Cronet) matches names in the SAN only. It must never change
    # after this: daal-relay-mgmt copies it on re-issue, because a
    # naive pack's trusted root is found by this name (tlscert.go).
    # 64 is X.509's limit on a CN (openssl refuses longer).
    if [ "${#DAAL_CN}" -gt 64 ]; then DAAL_CN="${DAAL_IP4}"; fi
    if [ -z "$DAAL_CN" ]; then DAAL_CN="${DAAL_IP6:-localhost}"; fi
    run openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
      -keyout /etc/daal/tls-key.pem -out /etc/daal/tls-cert.pem \
      -days 90 -nodes -subj "/CN=${DAAL_CN}" \
      -addext "subjectAltName=${DAAL_SAN}"
    run chmod 0600 /etc/daal/tls-key.pem
    run chmod 0644 /etc/daal/tls-cert.pem
    # The pin of that key (base64 SHA-256 of the SubjectPublicKeyInfo),
    # beside reality.pub, for the provisioner to read into the
    # OperatorRecord. bind-and-sign commits every pinned route to it
    # (specs/relaypack-v1.md "Endpoint commitment"); the Hetzner
    # provisioner has always tried to read this file and nothing wrote it.
    openssl x509 -in /etc/daal/tls-cert.pem -pubkey -noout \
      | openssl pkey -pubin -outform DER | openssl dgst -sha256 -binary \
      | base64 > /etc/daal/tls-spki-sha256.b64 || fail "tls spki pin failed"
    run chmod 0644 /etc/daal/tls-spki-sha256.b64
    run systemctl daemon-reload
    run systemctl enable --now sing-box
    run systemctl enable --now daal-health
    run systemctl enable --now daal-relay-mgmt
    sleep 300
    rm -f /root/.ssh/authorized_keys
    sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config || true
    sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config || true
    systemctl disable --now ssh.service 2>/dev/null || systemctl disable --now sshd.service || true
    ufw --force delete allow from {{ .ProvisioningClientIP }} to any port 22 proto tcp || true
    ufw --force delete allow from {{ .ProvisioningClientIP }} to any port 9876 proto tcp || true
    systemctl stop daal-health || true
    systemctl disable daal-health || true
    DAAL_PROVISION
  # FRP-10 invariant 18: box-side ufw does NOT open the mgmt port.
  # The cloud-provider firewall (per Provider.SetEphemeralFirewallRule)
  # is the gate, opened by the Helper for ~5 minutes per L1/L2 op.

final_message: "Daal relay V2 ready in $UPTIME seconds"
