#!/bin/bash
# daal-fetch-verify — base-image-only artefact verifier (supplement §9.2.1).
# Uses bash + python3 stdlib + openssl. No bootstrap binary downloaded
# before signature verification.
#
# Args: $1=manifest.json $2=release.pub $3=target-bin-dir
set -euo pipefail
MANIFEST=$1
PUBKEY=$2
TARGET=$3
python3 -c "$(cat <<'PY'
import json, hashlib, subprocess, sys, urllib.request, os, tempfile
m = json.load(open(sys.argv[1]))
pub = sys.argv[2]; target = sys.argv[3]
for art in m["artefacts"]:
    ok = False; why = []
    for url in art["mirrors"]:
        tmp = sig_path = None
        try:
            data = urllib.request.urlopen(url, timeout=30).read()
            if hashlib.sha256(data).hexdigest() != art["sha256"]:
                why.append(f"{url}: sha256 mismatch"); continue
            # Beside the destination, never /tmp: rename(2) cannot cross
            # mounts, and /tmp is a tmpfs on many images.
            with tempfile.NamedTemporaryFile(dir=target, prefix=".fetch-", delete=False) as f:
                tmp = f.name; sig_path = tmp + ".sig"
                f.write(data); f.flush(); os.fsync(f.fileno())
            open(sig_path, "wb").write(bytes.fromhex(art["sig_hex"]))
            r = subprocess.run(
                ["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", pub,
                 "-rawin", "-in", tmp, "-sigfile", sig_path],
                capture_output=True)
            if r.returncode != 0:
                why.append(f"{url}: signature did not verify"); continue
            dst = os.path.join(target, art["install_as"])
            os.chmod(tmp, 0o755); os.replace(tmp, dst); tmp = None
            ok = True; break
        except Exception as e:
            why.append(f"{url}: {type(e).__name__}: {e}")
        finally:
            for p in (tmp, sig_path):
                if p and os.path.exists(p):
                    os.unlink(p)
    if not ok:
        print(f"FAIL: no mirror passed verification for {art['name']}", file=sys.stderr)
        for w in why:
            print(f"  {w}", file=sys.stderr)
        sys.exit(1)
PY
)" "$MANIFEST" "$PUBKEY" "$TARGET"
