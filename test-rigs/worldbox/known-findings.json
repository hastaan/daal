[
  {
    "id": "CEN-4",
    "severity": "medium",
    "title": "one route cannot tell apart what needs two observations: every silent UDP route is udp_no_reply (network-wide UDP loss, a QUIC-only filter, a dead address, a dead port), and a reset after the ClientHello is tls_sni_or_cert_block_suspected whether the filter is keyed on the name or the address",
    "match": [
      {
        "phase": "family",
        "family": "hysteria2,tuic",
        "check": "engine.category",
        "expect_not": [
          "none",
          "path_too_slow"
        ],
        "got": "udp_no_reply"
      },
      {
        "scenario": "tcp-reset-mid-handshake",
        "phase": "family",
        "family": "vless-reality,websocket-tls,anytls",
        "check": "engine.category",
        "got": "tls_sni_or_cert_block_suspected"
      }
    ]
  },
  {
    "id": "F-002",
    "severity": "high",
    "title": "the pinned daal-relay-mgmt release predates Wave 5: shadowsocks, anytls and tuic cannot be provisioned",
    "when": {
      "box": "pinned"
    },
    "match": [
      {
        "phase": "mint",
        "family": "anytls,shadowsocks,tuic",
        "check": "relay.listens,pack.route"
      },
      {
        "phase": "mint",
        "family": "-",
        "check": "users-provision.*.no_warnings,pack.*.no_dropped_routes,bind-and-sign.every_route_has_a_signed_endpoint"
      },
      {
        "phase": "family",
        "family": "anytls,shadowsocks,tuic",
        "check": "tunnel,engine.category"
      }
    ]
  },
  {
    "id": "LC-1",
    "severity": "low-medium",
    "title": "the pinned daal-relay-mgmt release honours a replayed users-revoke token (fixed in the tree)",
    "when": {
      "box": "pinned"
    },
    "match": [
      {
        "phase": "op:mgmtauth",
        "check": "replay.users-revoke",
        "got": "pass"
      }
    ]
  },
  {
    "id": "INT-2",
    "severity": "medium",
    "title": "naive on a released relay: sing-box's start-up ALPN race now and then leaves naive/TCP refusing every handshake (alert 120, Cronet net_error -107) until its next restart (fixed in the tree daemon; intermittent)",
    "intermittent": true,
    "max": 4,
    "when": {
      "box": "pinned"
    },
    "match": [
      {
        "phase": "*",
        "family": "naive",
        "check": "*tunnel,*wire",
        "detail_contains": "net_error -107"
      }
    ]
  }
]
