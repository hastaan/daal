<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions + <service> declarations for Daal's VpnService. These
  merge into the app manifest at Gradle build time, which is the only
  durable place to put them: client-shell/tauri/src-tauri/gen/android/
  is gitignored and regenerated by `tauri android init` between
  sessions.

  Per Phase 45 invariant 6, this file is the source of truth for the
  VPN-related Android surface. The merged result must appear in
  app/build/intermediates/merged_manifest/.../AndroidManifest.xml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="org.daal.desktop.vpn.DaalVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
