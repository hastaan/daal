{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Daal",
    "version": "0.2.0",
    "identifier": "org.daal.desktop",
    "build": {
        "frontendDist": "../../../client-ui/dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm --prefix ../../client-ui run dev",
        "beforeBuildCommand": "npm --prefix ../../client-ui run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Daal",
                "width": 1280,
                "height": 820,
                "minWidth": 960,
                "minHeight": 600,
                "decorations": true,
                "transparent": false,
                "resizable": true,
                "maximizable": true,
                "minimizable": true,
                "closable": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "category": "Utility",
        "shortDescription": "Daal — anti-censorship client",
        "longDescription": "Daal is an anti-censorship client targeting hostile network environments. The desktop client runs a long-lived sing-box sidecar and dlopens a native engine library. No analytics, no usage data leaves the device.",
        "targets": ["deb", "rpm", "appimage", "nsis", "msi", "app", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": ["resources/*"],
        "linux": {
            "deb": {
                "depends": []
            }
        },
        "windows": {
            "wix": {
                "language": "en-US"
            }
        },
        "android": {
            "minSdkVersion": 24
        },
        "iOS": {
            "minimumSystemVersion": "14.0"
        }
    },
    "plugins": {}
}
